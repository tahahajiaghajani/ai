# ---- Pars website — environment variables (Vercel → Settings → Environment Variables) ----
# The build works without any of these; features turn on as they are set.

# Public address of the site (used for SEO, sitemap and links in notifications)
NEXT_PUBLIC_SITE_URL=https://pars.example.com

# Supabase (Project Settings → API). Only used on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hidden admin panel at /admin
ADMIN_PASSWORD=
# Random 32+ characters: signs the admin session and encrypts API keys stored in the database
APP_SECRET=

# Optional fallback AI key (Google AI Studio, free). The key entered in /admin takes priority.
GEMINI_API_KEY=
