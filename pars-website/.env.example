# ---- Pars website — environment variables (Vercel → Settings → Environment Variables) ----
# The build works without any of these; features turn on as they are set.

# Public address of the site (used for SEO, sitemap and links in notifications)
NEXT_PUBLIC_SITE_URL=https://pars.example.com

# Supabase (Project Settings → API). Only used on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hidden admin panel at /admin
ADMIN_PASSWORD=
# Random 32+ characters: signs the admin session and encrypts API keys stored in the database
APP_SECRET=
# Optional, for rotation: the old APP_SECRET (or the old service-role key, if APP_SECRET was never set).
# Values encrypted with it stay readable; new values use APP_SECRET. Keep it set.
APP_SECRET_PREVIOUS=

# Optional fallback AI key (Google AI Studio, free). The key entered in /admin takes priority.
GEMINI_API_KEY=
# Optional: AI calls per day shared by all visitors (chat, ticket suggestions, triage); default 1500.
# When it is reached the chat says it is busy and tickets are saved without AI until the next day.
AI_DAILY_LIMIT=

# Optional: protects /api/keepalive, the daily cron (vercel.json) that keeps the free Supabase project awake
CRON_SECRET=
