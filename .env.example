# ------------------------------------------------------------------
# TaskFlow AI — متغیرهای محیطی (در Vercel: Project → Settings → Environment Variables)
# این فایل فقط نمونه است؛ مقادیر واقعی را هرگز در مخزن commit نکنید.
# ------------------------------------------------------------------

# Supabase → Project Settings → API Keys (یا Data API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...        # یا کلید publishable: sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...            # یا کلید secret: sb_secret_...  (محرمانه)

# ایمیلی که با آن وارد اپ اصلی می‌شوید (به‌صورت خودکار مدیر می‌شود)
ADMIN_EMAIL=you@example.com

# Google AI Studio → Get API key
GEMINI_API_KEY=

# GitHub → Settings → Developer settings → Personal access tokens (classic) با دسترسی repo و workflow
GITHUB_TOKEN=
GITHUB_OWNER=your-github-username
GITHUB_APP_REPO=ai                 # مخزن کد همین اپ (برای ارتقای خودکار)
GITHUB_WORKSPACE_REPO=ai-workspace # مخزن خروجی تسک‌ها و پایگاه دانش (خودکار ساخته می‌شود)

# یک رشته‌ی تصادفی طولانی (مثلاً خروجی: openssl rand -hex 32)
CRON_SECRET=

# اختیاری
# APP_URL=https://your-app.vercel.app   # اگر خالی باشد از دامنه‌ی production خود Vercel استفاده می‌شود
# WORKER_BUDGET_SECONDS=50              # در پلن Pro Vercel می‌توانید بیشتر کنید (و maxDuration را هم)
