# ------------------------------------------------------------------
# Task Flow — متغیرهای محیطی (در Vercel: Project → Settings → Environment Variables)
# این فایل فقط نمونه است؛ مقادیر واقعی را هرگز در مخزن commit نکنید.
# کلیدهای هوش مصنوعی و GitHub هر کاربر داخل خود اپ (تنظیمات و اتصال‌ها) ثبت و رمزنگاری‌شده ذخیره می‌شوند؛
# این‌جا فقط تنظیمات مشترک اپ است که فقط مالک اپ مدیریت می‌کند.
# ------------------------------------------------------------------

# Supabase → Project Settings → API Keys (یا Data API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...        # یا کلید publishable: sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...            # یا کلید secret: sb_secret_...  (محرمانه)

# ایمیل مالک اپ (با اولین ورود با این ایمیل مالک می‌شوید؛ نام قدیمی: ADMIN_EMAIL)
OWNER_EMAIL=you@example.com

# یک رشته‌ی تصادفی طولانی برای زمان‌بند و runnerهای GitHub Actions (مثلاً خروجی: openssl rand -hex 32)
CRON_SECRET=

# کلید رمزنگاری کلیدهای کاربران (AES-256-GCM) — قبل از اینکه کسی کلیدی وصل کند تنظیم کنید و بعداً عوضش نکنید
# (openssl rand -hex 32). اگر خالی باشد از کلید سرویس Supabase مشتق می‌شود.
APP_SECRET_KEY=

# اختیاری — فقط برای «ارتقای اپلیکیشن» مالک (Claude Code روی مخزن کد همین اپ)
# GITHUB_TOKEN=                      # توکن classic با دسترسی repo و workflow
# GITHUB_OWNER=your-github-username
# GITHUB_APP_REPO=ai

# اختیاری
# APP_URL=https://your-app.vercel.app      # خالی = دامنه‌ی production خود Vercel
# WORKSPACE_REPO_NAME=taskflow-workspace   # نام پیش‌فرض مخزن کاری که برای هر کاربر ساخته می‌شود
# WORKER_BUDGET_SECONDS=240                # با Fluid compute هر اجرای ورکر تا ۳۰۰ ثانیه
