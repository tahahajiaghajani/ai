# The site builds and runs without any of these; the panel, requests and the assistant switch on when the first four
# are set. There is no database: requests, settings and extra knowledge live in a private GitHub repository.
# See docs/SETUP_FA.md.

# Required for the panel, requests and the assistant ------------------------------------------------------------
# A fine-grained token with access to ONE private repository: Contents and Issues read/write.
GITHUB_TOKEN=
# That private repository, as owner/name (e.g. tahahajiaghajani/portfolio-data).
GITHUB_REPO=
# The hidden panel at /admin.
ADMIN_PASSWORD=
# 32+ random characters: encrypts the keys saved in the panel and signs the admin session and tracking links.
APP_SECRET=

# Optional ---------------------------------------------------------------------------------------------------------
# Public address (canonical URLs, sitemap, share images, links in notifications). Vercel's production URL when empty.
NEXT_PUBLIC_SITE_URL=
# After rotating APP_SECRET: the old value, so keys saved with it can still be read and old tracking links still open.
APP_SECRET_PREVIOUS=
# Google AI Studio key. Better saved in the panel (Connections), which takes precedence.
GEMINI_API_KEY=
# Models tried before the built-in free chain, comma separated (the panel's list takes precedence).
GEMINI_MODELS=
# AI calls per day for each server instance (chat + triage). Default 1000.
AI_DAILY_LIMIT=
# A Telegram (or Bale) bot. Better saved in the panel, which takes precedence.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# "bale" to send through Bale's Bot API instead of Telegram.
TELEGRAM_API=
# GitHub Enterprise Server API (or a local mock in tests). Default https://api.github.com
GITHUB_API_URL=
