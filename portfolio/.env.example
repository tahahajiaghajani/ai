# Every variable is optional: the site builds and runs without any of them, and each feature
# switches on when its variables are set. See docs/SETUP_FA.md.

# Public address (canonical URLs, sitemap, share images). Vercel's production URL is used when empty.
NEXT_PUBLIC_SITE_URL=

# Supabase (requests, chat log, extra knowledge, rate limits). Tables are prefixed portfolio_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio (free tier) for the assistant and request triage.
GEMINI_API_KEY=
# Optional: models tried before the built-in free chain, comma separated.
GEMINI_MODELS=
# AI calls per day shared by every visitor (chat + triage). Default 1000.
AI_DAILY_LIMIT=

# The hidden inbox at /admin, and the secret that signs its session and the tracking links.
ADMIN_PASSWORD=
APP_SECRET=

# Optional: a Telegram (or Bale) bot that receives every new request and visitor reply.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set to "bale" to send through Bale's Bot API instead of Telegram.
TELEGRAM_API=

# Optional: protects the daily keep-alive cron (Vercel sends it as a Bearer token).
CRON_SECRET=
