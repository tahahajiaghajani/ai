{
  "name": "itsm",
  "version": "1.0.0",
  "private": true,
  "description": "ITSM — سامانهٔ سازمانی مدیریت خدمات فناوری اطلاعات با هوش مصنوعی (وب + ویندوز)",
  "scripts": {
    "dev": "next dev",
