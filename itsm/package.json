    "@dagrejs/dagre": "^3.1.1",
    "@electric-sql/pglite": "^0.5.14",
    "@hono/node-server": "^2.1.5",
    "@tanstack/react-query": "^5.105.1",
    "@xyflow/react": "^12.12.0",
    "antd": "^6.6.8",
    "dayjs": "^1.11.23",
    "decimal.js": "^10.6.0",
    "hono": "^4.13.16",
    "imapflow": "^2.9.1",
    "jalaali-js": "^2.0.1",
    "lucide-react": "1.59.0",
    "mailparser": "^3.12.4",
