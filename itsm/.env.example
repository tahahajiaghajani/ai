# «تراز» — متغیرهای محیطی نسخه‌ی وب (Vercel → Settings → Environment Variables). راهنما: docs/SETUP_FA.md
# لازم: Supabase → Connect → Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# پیشنهادی
APP_SECRET=
PLATFORM_ADMIN_EMAILS=you@example.com
# اختیاری
ALLOW_SIGNUP=true
CRON_SECRET=
AUTO_MIGRATE=true
DATABASE_POOL_MAX=3
# فقط برای پایگاه داده‌ی محلی بدون SSL
# DATABASE_SSL=disable
