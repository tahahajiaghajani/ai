# ITSM (نام موقت) — متغیرهای محیطی نسخهٔ وب (Vercel → Settings → Environment Variables، فقط Production). راهنما: docs/SETUP_FA.md
# لازم: Supabase → Connect → Transaction pooler (port 6543). به‌جای آن SUPABASE_DB_URL یا POSTGRES_URL هم پذیرفته می‌شود.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres
# عملاً لازم: کلید رمزنگاری کلیدهای هوش مصنوعی و وب‌هوک‌ها (openssl rand -hex 32)؛ پس از گذاشتن عوض نکنید
APP_SECRET=
# پیشنهادی: ایمیل(های) مدیر کل سامانه، با «,»
PLATFORM_ADMIN_EMAILS=you@example.com
# پیشنهادی: بستن نشانی /api/cron/keepalive (openssl rand -hex 16)
CRON_SECRET=
# اختیاری
ALLOW_SIGNUP=true
# ساخت Vercel (و اگر نشد، خود برنامه در پس‌زمینهٔ درخواست‌ها) پایگاه داده را مرحله‌به‌مرحله می‌سازد؛ با false فقط scripts/migrate-db.mts
AUTO_MIGRATE=true
DATABASE_POOL_MAX=3
PUBLIC_URL=
# فقط برای پایگاه دادهٔ محلی بدون SSL (هرگز برای Supabase)
# DATABASE_SSL=disable
# فقط برای آزمون‌ها و نسخهٔ ویندوز (در Vercel نگذارید): ITSM_AI_FAKE، ITSM_DATA_DIR، ITSM_STATIC_DIR، ITSM_PORT، ITSM_SMOKE، ITSM_SMOKE_OUT، ITSM_UI_OUT
