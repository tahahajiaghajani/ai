# ---- CELIN website — environment variables (Vercel → Settings → Environment Variables) ----
# The build works without any of these; features turn on as they are set. Never commit real values.

# Public address of the site (SEO, sitemap, links in messages). Later: your own domain.
NEXT_PUBLIC_SITE_URL=https://celin.example.com

# Supabase (Project Settings → API Keys). Only used on the server, never sent to the browser.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional: storage bucket for pictures (created by the SQL file), default celin-media
SUPABASE_BUCKET=

# Admin panel at /admin. Required for the first activation: sign up on the site with your mobile, open /admin
# and enter this password once — your account becomes an admin and from then on a normal sign-in opens the
# panel. It also works alone as a break-glass login (this browser only; it never changes an account).
ADMIN_PASSWORD=
# Optional allow-list: when set (mobiles, comma or space separated), only accounts with these numbers can be
# made admin with ADMIN_PASSWORD. A number alone never grants anything.
ADMIN_PHONES=
# Random 32+ characters (e.g. `openssl rand -hex 32`): signs sessions, hashes Pro codes, encrypts stored keys.
# Recommended (falls back to the service-role key). Set it before the first Pro code is issued and keep it.
APP_SECRET=
# Only after a rotation: the previous APP_SECRET, so earlier codes and keys stay valid.
APP_SECRET_PREVIOUS=

# Optional: e-mail through Resend (also settable in Admin → Settings)
RESEND_API_KEY=
MAIL_FROM=

# Optional: protects /api/keepalive, the daily cron (vercel.json) that keeps the free Supabase project awake
CRON_SECRET=

# Visitor IP for rate limits, behind a proxy or CDN (docs/SETUP_FA.md §7). Not needed on Vercel alone.
# TRUSTED_IP_HEADER: the header your proxy writes the visitor's IP into — x-real-ip (nginx:
# proxy_set_header X-Real-IP $remote_addr), ar-real-ip (ArvanCloud), or x-forwarded-for when your proxy
# overwrites it (the right-most entry is read). Self-hosted without it, visitors cannot be told apart and
# share one rate-limit bucket (safe but strict).
TRUSTED_IP_HEADER=
# A random string your proxy / CDN sends in the x-celin-proxy header; TRUSTED_IP_HEADER is then honoured only
# on requests carrying it. Required for a CDN in front of Vercel (the deployment is also reachable directly).
TRUSTED_PROXY_SECRET=
