{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "p=${VERCEL_GIT_PREVIOUS_SHA:-HEAD^};[ \"$p\" = \"$VERCEL_GIT_COMMIT_SHA\" ]&&exit 1;git cat-file -e \"$p^{commit}\" 2>/dev/null&&git diff --quiet \"$p\" HEAD -- . ':!siraf' ':!itsm' ':!pars-website' ':!celin-website' ':!portfolio'||exit 1",
  "crons": [
    { "path": "/api/cron/daily", "schedule": "30 3 * * *" }
  ]
}
